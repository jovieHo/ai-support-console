DATABASE_URL=sqlite:///./neusoft_ai.db
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,http://127.0.0.1:5177,http://localhost
SECRET_KEY=please-change-this-secret

# OpenAI-compatible LLM. 默认阿里云百炼（DashScope 兼容模式）。
# Key 按 LLM_API_KEY → DASHSCOPE_API_KEY → OPENAI_API_KEY 顺序读取，任一即可。
LLM_PROVIDER=dashscope
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_TEMPERATURE=0.3

# embedding（Embedding 走 OpenAI 兼容协议，示例使用阿里云百炼 Qwen）
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v3
EMBED_API_KEY=
CHROMA_PERSIST_DIR=./storage/chroma
